// Ticket 113, roadmap H3. Mine: a surface complex over a primary shaft that
// slowly digs itself deeper and wider over time — see MINES_DESIGN.md for
// the full geometry. Like the Gatherer's Hut, it has no recipe: what comes
// out is whatever was actually there, resolved through drops.ron.
//
// Real geometry (ticket 118): mine.nbt, a timber headframe over the shaft
// with a storage shed and yard decoration. The headframe floor (y=1) is one
// uniform cobblestone slab across the whole shaft footprint — lining, ring
// and interior alike, the same material city::mine::layout's GROUND
// constant digs with underground — so there is no seam at the shaft's
// border whether or not the mine has started sinking yet.
Building(
    name: "Mine",
    blueprint: "mine.nbt",
    tier: 1,
    requires: [],
    category: Production,
    footprint: Explicit(x: 16, z: 16),
    ground_level: 1,
    cost: [
        (block: "minecraft:oak_planks", count: 64),
        (block: "minecraft:oak_log", count: 32),
        (block: "minecraft:cobblestone", count: 64),
    ],
    mine: Some((
        // Unrotated blueprint (x, z); rotated with the footprint at
        // placement (city::mine::layout, ticket 114).
        shaft: (x: 5, z: 5),
        shaft_size: 6,
        // A whole multiple of level_spacing (shaft_size - 2 == 4): the
        // first level's landing has to fall on a ring corner.
        first_level_depth: 12,
        // Coal/iron/copper band. mine02/mine03 reach further.
        min_level_y: 16,
        level_reach: 100,
        gallery_length: 200,
        blocks_per_minute: 60.0,
        buffer_stacks: 512,
        haul_at_stacks: Some(64),
    )),
    integrity: Integrity(
        pristine_above: 0.95,
        ruined_below: 0.60,
    ),
)
